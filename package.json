{
  "name": "tringify-app-starter",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
